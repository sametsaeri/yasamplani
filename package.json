{
  "name": "hesap-planim",
  "version": "1.1.6",
  "private": true,
  "main": "elektron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "desktop:dev": "set ELECTRON_DEV=1&& electron .",
    "desktop": "set NEXT_EXPORT=1&& next build && electron .",
    "dist": "set NEXT_EXPORT=1&& next build && electron-builder --win nsis"
  },
  "dependencies": {
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.454.0",
    "next": "14.2.18",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "autoprefixer": "^10.4.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.0",
    "prisma": "^6.16.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0"
  },
  "build": {
    "appId": "com.hesapplanim.masaustu",
    "productName": "Hesap Planım",
    "files": [
      "out/**/*",
      "elektron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "kurulum"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Hesap Planım"
    }
  }
}
